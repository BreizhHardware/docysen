{
  "name": "docysen",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nx run-many -t dev --parallel=8",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:coverage": "nx run-many -t test:coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "graph": "nx graph",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@nx/js": "^23.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nx": "^23.2.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
