# Copier en .env(.local) et compléter. Voir packages/config pour la validation Zod.

NODE_ENV=development
PORT=3001

# --- auth-service ---
JWT_SECRET=changeme-min-32-caracteres-generes-avec-openssl-rand-hex-32
JWT_EXPIRES_IN=1h
DATABASE_URL=postgresql://dev:dev@localhost:5432/docysen
WEBAURION_BASE_URL=https://web.isen-ouest.fr/webAurion
ISEN_EMAIL_DOMAIN=isen-ouest.yncrea.fr

# --- S3 / Garage ---
AWS_REGION=garage
AWS_ACCESS_KEY_ID=dev-key
AWS_SECRET_ACCESS_KEY=dev-secret
S3_BUCKET=docysen-dev
S3_ENDPOINT=http://localhost:3900

# --- Meilisearch ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=dev-master-key

# --- SMTP ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@isen-ouest.yncrea.fr

# --- frontend ---
VITE_API_BASE_URL=http://localhost:3001
