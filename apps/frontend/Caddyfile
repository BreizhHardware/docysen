:80 {
	log {
		output stdout
		format console
	}

	encode gzip

	handle_path /svc/auth/* {
		reverse_proxy auth-service:3001
	}

	handle_path /svc/api/* {
		reverse_proxy api-service:3002
	}

	handle /{$S3_BUCKET}/* {
		reverse_proxy garage:3900
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header -Server
}
